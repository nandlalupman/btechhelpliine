NODE_ENV=development
PORT=3000

# Database Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/btechhelpline?appName=BtechHelpline

# JWT Authentication Configuration
# (Leave JWT_SECRET blank/commented out to automatically generate & persist a cryptographically secure key in MongoDB settings)
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Email Transporter Credentials (required for real delivery; npm run local uses a private local inbox)
EMAIL_USER=
EMAIL_PASS=
# Optional sender name/email address (defaults to EMAIL_USER / noreply@btechhelpline.com value if left blank)
# EMAIL_FROM=noreply@btechhelpline.com
# EMAIL_FROM_NAME=BtechHelpline
# Optional Custom SMTP settings (defaults to Gmail port 587 if left blank)
# EMAIL_SERVICE=gmail
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_SECURE=false

# 2Factor.in SMS Gateway Integration API Key
TWO_FACTOR_API_KEY=your-actual-2factor-api-key-here

# Public origin used for email links and allowed browser requests
FRONTEND_URL=http://localhost:4173
# Required for an external scheduled reminder job on serverless hosting.
# Invoke GET /api/journey/reminders/run using Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=


